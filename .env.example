NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_CODE_SECRET=

# Option A — provisoire avec Gmail personnel (auth e-mail Supabase / SMTP)
EMAIL_PROVIDER=gmail_smtp
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=

# Option B — production avec domaine d'envoi vérifié
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=MAGNISA <noreply@your-domain.example>

# Connexion Gmail des entreprises via Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 octets encodés en base64. Ne jamais exposer côté client.
GOOGLE_TOKEN_ENCRYPTION_KEY=
