# Copy to .env.local-dev (never commit the populated file).
# Supabase local URL is reachable from the worker container through host-gateway.
# Keep the service-role key server-side; never expose it to browser code.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
