# Copy to .env.local-dev (never commit the populated file).
# For Supabase CLI running on the host, Docker Desktop and Linux host-gateway
# resolve host.docker.internal to the local machine.
MAGNIBOX_WORKER_SUPABASE_URL=http://host.docker.internal:54321
MAGNIBOX_WORKER_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
