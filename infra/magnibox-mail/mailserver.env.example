# Copy to mailserver.env on the dedicated MTA host.
# Do not commit mailserver.env, credentials, DKIM private keys or certificates.

ACCOUNT_PROVISIONER=FILE
POSTMASTER_ADDRESS=postmaster@example.invalid

# Mailbox and message limits (bytes).
ENABLE_QUOTAS=1
POSTFIX_MAILBOX_SIZE_LIMIT=104857600
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
CLAMAV_MESSAGE_SIZE_LIMIT=26214400

# Mailbox access. POP3 is intentionally disabled.
ENABLE_IMAP=1
ENABLE_POP3=0

# Rspamd is the single antispam/content-filtering stack in this profile.
ENABLE_RSPAMD=1
ENABLE_RSPAMD_VALKEY=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=1

# Host firewall bans require NET_ADMIN, which is granted in compose.yaml.
ENABLE_FAIL2BAN=1

# Do not trust arbitrary Docker networks as mail relays.
PERMIT_DOCKER=none
TLS_LEVEL=modern
SSL_TYPE=manual
SSL_CERT_PATH=/run/magnibox-tls/fullchain.pem
SSL_KEY_PATH=/run/magnibox-tls/privkey.pem

# Keep update checks explicit and controlled by the operator.
ENABLE_UPDATE_CHECK=0

# Signed MAGNIBOX application bridges. Configure matching server-only secrets in MAGNISA.
MAGNIBOX_INBOUND_URL=https://magnisa.example/api/internal/magnibox/inbound
MAGNIBOX_INBOUND_WEBHOOK_SECRET=replace-with-a-dedicated-random-secret-at-least-32-chars
MAGNIBOX_PROVISIONING_URL=https://magnisa.example/api/internal/magnibox/provisioning
MAGNIBOX_PROVISIONING_WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-chars
MAGNIBOX_DELIVERY_EVENT_URL=https://magnisa.example/api/internal/magnibox/delivery-event
MAGNIBOX_DELIVERY_EVENT_WEBHOOK_SECRET=replace-with-a-third-dedicated-random-secret-at-least-32-chars
